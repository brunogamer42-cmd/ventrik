{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 21, "patch": 0 },
  "configurePresets": [
    {
      "name": "moderna",
      "displayName": "Moderna (Windows 10 y 11, 64 bits)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "v143", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/moderna",
      "cacheVariables": { "VENTRIK_VERSION": "moderna" }
    },
    {
      "name": "clasica",
      "displayName": "Clasica (Windows XP SP3 a 8.1, 32 bits)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "Win32", "strategy": "set" },
      "toolset": { "value": "v141_xp", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/clasica",
      "cacheVariables": { "VENTRIK_VERSION": "clasica" }
    },
    {
      "name": "fuzzing64",
      "displayName": "Fuzzing de 64 bits (AddressSanitizer, nunca se publica)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "v143", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/fuzzing64",
      "cacheVariables": { "VENTRIK_VERSION": "fuzzing" }
    },
    {
      "name": "fuzzing32",
      "displayName": "Fuzzing de 32 bits (AddressSanitizer, nunca se publica)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "Win32", "strategy": "set" },
      "toolset": { "value": "v143", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/fuzzing32",
      "cacheVariables": { "VENTRIK_VERSION": "fuzzing" }
    },
    {
      "name": "asan64",
      "displayName": "Servidor con AddressSanitizer (64 bits, para atacarlo; nunca se publica)",
      "generator": "Visual Studio 17 2022",
      "architecture": { "value": "x64", "strategy": "set" },
      "toolset": { "value": "v143", "strategy": "set" },
      "binaryDir": "${sourceDir}/build/asan64",
      "cacheVariables": { "VENTRIK_VERSION": "asan" }
    }
  ],
  "buildPresets": [
    { "name": "moderna", "configurePreset": "moderna", "configuration": "Release" },
    { "name": "clasica", "configurePreset": "clasica", "configuration": "Release" },
    { "name": "fuzzing64", "configurePreset": "fuzzing64", "configuration": "Release" },
    { "name": "fuzzing32", "configurePreset": "fuzzing32", "configuration": "Release" },
    { "name": "asan64", "configurePreset": "asan64", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "moderna",
      "configurePreset": "moderna",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    {
      "name": "clasica",
      "configurePreset": "clasica",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    }
  ]
}
